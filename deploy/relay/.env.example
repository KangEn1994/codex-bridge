# Public HTTPS origin served by the reverse proxy.
CODEX_RELAY_PUBLIC_URL=https://bridge.example.com

# Generate two independent values with at least 32 random characters each.
# Example: openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
CODEX_RELAY_HOST_TOKEN=
CODEX_RELAY_PHONE_TOKEN=

PORT=8080
HOST=0.0.0.0
CODEX_RELAY_WEB_PORT=3000
CODEX_RELAY_WEB_INTERNAL_URL=http://127.0.0.1:3000
CODEX_RELAY_TRUST_PROXY=true
